---
// Footer - CSS imported in layout

const currentYear = new Date().getFullYear();
---

<footer class="align-center">
  <div class="socials">
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/NikosTsigkros"
      aria-label="GitHub (opens in a new tab)"
      ><i class="icon ion ion-social-github" aria-hidden="true"></i></a
    >
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://www.linkedin.com/in/nikolaostsigkros/"
      aria-label="LinkedIn (opens in a new tab)"
      ><i class="icon ion ion-social-linkedin" aria-hidden="true"></i></a
    >
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://codepen.io/TsigkrosNikos"
      aria-label="CodePen (opens in a new tab)"
      ><i class="icon ion ion-social-codepen" aria-hidden="true"></i></a
    >
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://www.instagram.com/NikosNikos_the_greek/"
      aria-label="Instagram (opens in a new tab)"
      ><i class="icon ion ion-social-instagram" aria-hidden="true"></i></a
    >
  </div>
  <div class="copy">© {currentYear} tsigros.gr. All rights reserved.</div>
</footer>