---
import WorkItem from "./WorkItem.astro";
import { works } from "../settings/works";
---

<section
  style="background-color: #f9f9f9"
  class="section works align-left"
  id="works-section"
  aria-labelledby="works-section-title"
>
  <div class="fw">
    <div class="titles">
      <h2 class="title" id="works-section-title">My Work</h2>
    </div>
    <fieldset class="filters" aria-labelledby="works-filters-legend">
      <legend id="works-filters-legend" class="visually-hidden">
        Filter projects by technology
      </legend>
      <div class="f_btn active">
        <label
          ><input type="radio" name="fl_radio" value="box-item" checked />All</label
        >
      </div>
      <div class="f_btn">
        <label
          ><input type="radio" name="fl_radio" value="f-nextjs" />Nextjs</label
        >
      </div>
      <div class="f_btn">
        <label
          ><input type="radio" name="fl_radio" value="f-react" />React</label
        >
      </div>
      <div class="f_btn">
        <label
          ><input type="radio" name="fl_radio" value="f-nodejs" />Nodejs</label
        >
      </div>
      <div class="f_btn">
        <label
          ><input
            type="radio"
            name="fl_radio"
            value="f-wordpress"
          />Wordpress</label
        >
      </div>
    </fieldset>
    <div class="row box-items">
      {works.map((work) => <WorkItem {...work} />)}
    </div>
  </div>
</section>
