---
// Contact section - CSS imported in layout
---

<section class="section contacts align-left" id="contact-section" aria-labelledby="contact-section-title">
  <div class="fw">
    <div class="titles">
      <h2 class="title" id="contact-section-title">Contact Me</h2>
    </div>
    <div class="contact-form">
      <form id="cform" method="post" novalidate aria-describedby="contact-required-hint">
        <p id="contact-required-hint" class="visually-hidden">
          Fields marked as required must be filled in before sending.
        </p>
        <div class="row">
          <div class="col col-m-12 col-t-6 col-d-6">
            <div class="value">
              <label for="contact-name">Name <span aria-hidden="true">*</span></label>
              <input
                id="contact-name"
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Name *"
                required
                aria-required="true"
              />
            </div>
          </div>
          <div class="col col-m-12 col-t-6 col-d-6">
            <div class="value">
              <label for="contact-tel">Phone <span aria-hidden="true">*</span></label>
              <input
                id="contact-tel"
                type="tel"
                name="tel"
                autocomplete="tel"
                placeholder="Phone *"
                required
                aria-required="true"
              />
            </div>
          </div>
          <div class="col col-m-12 col-t-6 col-d-6">
            <div class="value">
              <label for="contact-email">Email <span aria-hidden="true">*</span></label>
              <input
                id="contact-email"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Email *"
                required
                aria-required="true"
                inputmode="email"
              />
            </div>
          </div>
          <div class="col col-m-12 col-t-6 col-d-6">
            <div class="value">
              <label for="contact-subject">Subject <span aria-hidden="true">*</span></label>
              <input
                id="contact-subject"
                type="text"
                name="subject"
                autocomplete="off"
                placeholder="Subject *"
                required
                aria-required="true"
              />
            </div>
          </div>
          <div class="col col-m-12 col-t-12 col-d-12">
            <div class="value">
              <label for="contact-message">Message <span aria-hidden="true">*</span></label>
              <textarea
                id="contact-message"
                name="message"
                placeholder="Message"
                required
                aria-required="true"
              ></textarea>
            </div>
          </div>
          <div class="col col-m-12 col-t-12 col-d-12">
            <button type="submit" class="btn">Send Message</button>
          </div>
        </div>
      </form>
      <div class="alert-success" role="status" aria-live="polite" aria-atomic="true">
        <p tabindex="-1">
          Thanks, your message is sent successfully. We will contact you
          shortly!
        </p>
      </div>
    </div>
  </div>
</section>